{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"gitIgnoredAuthors": [
		"128996893+hoverkraft-bot[bot]@users.noreply.github.com"
	],
	"enabledManagers": ["custom.regex"],
	"semanticCommits": "enabled",
	"semanticCommitType": "build",
	"minimumReleaseAge": "7 days",
	"packageRules": [
		{
			"matchManagers": ["custom.regex"],
			"groupName": "Docker build tooling"
		},
		{
			"matchFileNames": ["actions/docker/test-image/tooling.json"],
			"groupName": "Container test tooling"
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^actions/docker/setup/action\\.yml$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+default: \"(?:[^\"\\s]+:)?(?<currentValue>[^\"\\s]+)\""
			]
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^actions/docker/test-image/tooling\\.json$/"],
			"matchStrings": [
				"\"(?:nodeRunner|reaper)\":\\s*\"(?<depName>[^\"@]+):(?<currentValue>[^\"@:]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
			],
			"datasourceTemplate": "docker"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^actions/docker/test-image/tooling\\.json$/"],
			"matchStrings": ["\"gossVersion\":\\s*\"(?<currentValue>v[0-9.]+)\""],
			"datasourceTemplate": "github-releases",
			"depNameTemplate": "goss-org/goss"
		}
	]
}
