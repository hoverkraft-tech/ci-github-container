{
	"name": "generate-docs",
	"dependencies": {
		"@textlint/config-loader": "^15.8.0",
		"@textlint/kernel": "^15.8.0",
		"@textlint/resolver": "^15.8.0",
		"@textlint/textlint-plugin-markdown": "^15.8.0",
		"glob": "^14.0.6",
		"markdownlint-cli2": "^0.24.0",
		"prettier": "^3.9.10",
		"strip-json-comments": "^5.0.3",
		"textlint-filter-rule-comments": "^1.3.0",
		"textlint-rule-terminology": "^5.2.16"
	},
	"overrides": {
		"markdownlint-cli2": {
			"smol-toml": "^1.9.0"
		},
		"micromark-extension-math": {
			"katex": "^0.19.0"
		},
		"markdownlint": {
			"re2js": "^2.8.7"
		}
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"test": "node --test",
		"test:watch": "node --test --watch",
		"pretest:ci": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
		"test:ci": "node --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=coverage/junit.xml --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test",
		"build": "node build.mjs",
		"check:dist": "npm run build && git diff --exit-code -- dist && test -z \"$(git ls-files --others --exclude-standard -- dist)\"",
		"test:distribution": "node --test src/*.test.js"
	},
	"devDependencies": {
		"@vercel/ncc": "0.45.0",
		"esbuild": "0.28.2"
	}
}
